# --- required in production
OPENLOCALE_AUTH_SECRET=            # openssl rand -hex 32
OPENLOCALE_BASE_URL=http://localhost:5199

# --- database: sqlite file (default) or postgres URL
OPENLOCALE_DB_URL=file:./openlocale.db
# OPENLOCALE_DB_URL=postgres://openlocale:openlocale@localhost:5433/openlocale

# --- AI features (licensed): server-side translation fallback
# ANTHROPIC_API_KEY=sk-ant-…
# OPENLOCALE_AI_MODEL=claude-opus-4-8
# OPENLOCALE_MT_PROVIDER=claude

# --- SSO: allowlist non-public IdP origins for OIDC discovery (comma-separated)
# OPENLOCALE_TRUSTED_ORIGINS=http://localhost:15556

# --- public delivery endpoints: per-IP requests/minute backstop (0 disables)
# OPENLOCALE_CDN_RATE_LIMIT=300
